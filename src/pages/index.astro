---
import snapshot from '../data/holidays.json';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const fetchedAt = new Intl.DateTimeFormat('ja-JP', { dateStyle: 'long', timeStyle: 'short', timeZone: 'Asia/Tokyo' }).format(new Date(snapshot.metadata.fetchedAt));
const years = snapshot.metadata.years;
---
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="内閣府の祝日・休日データをJSONで取得できるAPIです。" />
    <title>日本の祝日 API</title>
  </head>
  <body>
    <main>
      <header class="page-header">
        <h1>日本の祝日 API</h1>
        <p>内閣府の祝日・休日データをJSONで取得できます。</p>
      </header>
      <section class="info" aria-label="データについて">
        <div><span>収録期間</span><strong>{years[0]}年 — {years.at(-1)}年</strong></div>
        <div><span>収録件数</span><strong>{snapshot.metadata.count.toLocaleString()}件</strong></div>
        <div><span>データ取得日時</span><strong>{fetchedAt}（日本時間）</strong></div>
      </section>
      <section class="explorer" aria-labelledby="explorer-title">
        <div class="section-heading"><div><p class="eyebrow">EXPLORE THE DATA</p><h2 id="explorer-title">祝日データを確認</h2></div><p>期間を選ぶと、APIから取得したJSONを表示します。</p></div>
        <div class="toolbar">
          <div class="select-wrap"><label for="year">取得する期間</label><select id="year"><option value="">全期間</option>{[...years].reverse().map(year => <option value={year}>{year}年</option>)}</select></div>
          <div class="url-wrap"><span>API URL</span><a id="api-url" href={`${base}/api/v1/date.json`}>{`${base}/api/v1/date.json`}</a></div>
        </div>
        <div class="response"><div class="response-head"><span>JSON RESPONSE</span><span id="status" role="status" aria-live="polite">読み込み中…</span></div><pre tabindex="0"><code id="result"></code></pre></div>
        <noscript>JSONの表示にはJavaScriptを有効にしてください。上のAPI URLから直接取得することもできます。</noscript>
      </section>
      <footer><p>出典：<a href="https://www8.cao.go.jp/chosei/shukujitsu/gaiyou.html" target="_blank" rel="noopener noreferrer">内閣府「国民の祝日」について <span class="external-note">（別ウィンドウで開きます）</span></a></p></footer>
    </main>
    <script>
      const select = document.querySelector<HTMLSelectElement>('#year')!;
      const link = document.querySelector<HTMLAnchorElement>('#api-url')!;
      const result = document.querySelector<HTMLElement>('#result')!;
      const status = document.querySelector<HTMLElement>('#status')!;
      const base = import.meta.env.BASE_URL.replace(/\/$/, '');
      let request = 0;
      async function load() {
        const current = ++request;
        const path = `${base}/api/v1/${select.value ? `${select.value}/` : ''}date.json`;
        link.href = path;
        link.textContent = path;
        status.textContent = '読み込み中…';
        result.textContent = '';
        try {
          const response = await fetch(path);
          if (!response.ok) throw new Error(`HTTP ${response.status}`);
          const data = await response.json();
          if (current !== request) return;
          result.textContent = JSON.stringify(data, null, 2);
          status.textContent = `${Object.keys(data).length.toLocaleString()}件`;
        } catch (error) {
          if (current !== request) return;
          status.textContent = '取得に失敗しました';
          result.textContent = `データを読み込めませんでした。${error instanceof Error ? error.message : ''}`;
        }
      }
      select.addEventListener('change', load);
      void load();
    </script>
  </body>
</html>
<style>
  :root { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Noto Sans JP', sans-serif; color: #20332d; background: #f6f7f2; font-synthesis: none; }
  * { box-sizing: border-box; }
  body { margin: 0; }
  main { max-width: 1100px; margin: auto; padding: 0 32px; }
  .page-header { padding-top: 48px; }
  .page-header h1 { font-size: 30px; margin: 0; }
  .page-header p { color: #63736b; line-height: 1.7; margin: 12px 0 0; }
  .eyebrow { color: #b4523b; font-size: 12px; font-weight: 800; letter-spacing: .17em; margin: 0 0 18px; }
  .info { display: flex; gap: 64px; border-block: 1px solid #d9e1d8; padding: 25px 0; margin-top: 32px; }
  .info div { display: grid; gap: 8px; }
  .info span, .toolbar label, .url-wrap > span { color: #738178; font-size: 12px; font-weight: 700; }
  .info strong { font-size: 15px; }
  .explorer { padding: 64px 0 50px; }
  .section-heading { display: flex; justify-content: space-between; align-items: end; gap: 20px; margin-bottom: 26px; }
  h2 { margin: 0; font-size: 26px; }
  .section-heading .eyebrow { margin-bottom: 10px; }
  .section-heading > p { color: #738178; font-size: 13px; margin: 0; }
  .toolbar { display: flex; gap: 32px; align-items: end; background: white; padding: 22px; border: 1px solid #e1e8df; border-radius: 10px 10px 0 0; }
  .select-wrap, .url-wrap { display: grid; gap: 8px; }
  select { min-width: 150px; padding: 10px 35px 10px 12px; border: 1px solid #ccd8ce; border-radius: 5px; background: white; color: #20332d; font: inherit; }
  a { color: #4b725d; overflow-wrap: anywhere; }
  .url-wrap a { font-family: monospace; font-size: 14px; padding-bottom: 10px; }
  .response { background: #22332d; color: #e1eae2; border-radius: 0 0 10px 10px; overflow: hidden; }
  .response-head { display: flex; justify-content: space-between; gap: 12px; padding: 16px 22px; border-bottom: 1px solid #415249; color: #b4c7b7; font-size: 11px; letter-spacing: .08em; }
  pre { margin: 0; padding: 22px; max-height: 480px; overflow: auto; line-height: 1.7; font-size: 13px; }
  footer { border-top: 1px solid #d9e1d8; padding: 22px 0 48px; color: #738178; font-size: 13px; line-height: 1.7; }
  .external-note { font-size: 12px; }
  :focus-visible { outline: 3px solid #bb6a51; outline-offset: 3px; }
  @media (max-width: 650px) { main { padding: 0 20px; } .page-header { padding-top: 32px; } .info { flex-wrap: wrap; gap: 22px 35px; margin-top: 24px; } .section-heading, .toolbar { align-items: stretch; flex-direction: column; } .toolbar { gap: 20px; } .explorer { padding-top: 48px; } }
</style>
